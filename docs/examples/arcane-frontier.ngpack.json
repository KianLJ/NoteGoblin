  "monsters": [],
  "optionLists": [
    {
      "id": "spirit-beasts",
      "name": "Spirit Beasts",
      "description": "Spirit animals a Beast Blood channeler can call.",
      "options": [
        {
          "id": "spirit-wolves",
          "name": "Spirit Wolves",
          "description": "A pair of spectral wolves that track by scent. You gain expertise in Perception, and can call them (2 Mana) to fight beside you.",
          "effects": [
            {
              "do": {
                "kind": "proficiency",
                "category": "skill",
                "value": "perception",
                "level": "expertise"
              }
            },
            {
              "do": {
                "kind": "grantCompanion",
                "companion": {
                  "id": "spirit-wolves",
                  "name": "Spirit Wolves",
                  "size": "Medium",
                  "creatureType": "Spirit",
                  "speed": "40 ft",
                  "ac": "12 + @prof",
                  "hp": "4 * @level + @self.con.mod",
                  "abilities": {
                    "str": "14",
                    "dex": "15",
                    "con": "13 + floor(@level / 4)",
                    "int": "6",
                    "wis": "14",
                    "cha": "6"
                  },
                  "attacks": [
                    {
                      "name": "Bite",
                      "bonus": "@self.dex.mod + @prof",
                      "damage": "1d8 + @self.dex.mod",
                      "damageType": "piercing",
                      "reach": "5 ft"
                    }
                  ],
                  "traits": [
                    {
                      "name": "Keen Smell",
                      "description": "Advantage on Wisdom (Perception) checks that rely on smell."
                    }
                  ],
                  "summonCost": {
                    "resourceId": "mana",
                    "amount": "2"
                  },
                  "states": [
                    "Enraged"
                  ]
                }
              }
            }
          ]
        },
        {
          "id": "spirit-hawk",
          "name": "Spirit Hawk",
          "description": "A great spectral hawk you can ride. You gain a flying speed of 30 feet.",
          "effects": [
            {
              "do": {
                "kind": "modify",
                "target": "speed.fly",
                "op": "set",
                "value": "30"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "physical-training",
      "name": "Physical Training",
      "description": "Point-buy physical upgrades.",
      "options": [
        {
          "id": "reinforced-frame",
          "name": "Reinforced Frame",
          "description": "Reduce bludgeoning, piercing and slashing damage you take by your proficiency bonus.",
          "cost": "2",
          "group": "toughness",
          "effects": [
            {
              "do": {
                "kind": "damageReduction",
                "amount": "@prof",
                "damageTypes": [
                  "bludgeoning",
                  "piercing",
                  "slashing"
                ],
                "label": "Reinforced Frame"
              }
            }
          ]
        },
        {
          "id": "swift-legs",
          "name": "Swift Legs",
          "description": "Your walking speed increases by 5 feet. Can be taken more than once.",
          "cost": "1",
          "effects": [
            {
              "do": {
                "kind": "modify",
                "target": "speed.walk",
                "op": "add",
                "value": "5"
              }
            }
          ]
        },
        {
          "id": "keen-eyes",
          "name": "Keen Eyes",
          "description": "Darkvision out to 60 feet (or +30 feet if you already have it).",
          "cost": "1",
          "effects": [
            {
              "do": {
                "kind": "modify",
                "target": "sense.darkvision",
                "op": "add",
                "value": "30 + 30 * (@sense.darkvision == 0)"
              }
            }
          ]
        }
      ]
    }
  ],
  "archetypes": [
    {
      "id": "storm-blood",
      "name": "Storm Blood",
      "description": "Storm magic runs in your veins, crackling around you. Prerequisite: channelling ability 16 or higher.",
      "tags": [
        "bloodline"
      ],
      "levelBasis": "highestClass",
      "prerequisite": {
        "kind": "formula",
        "formula": "@alias.ce.score >= 16"
      },
      "columns": [
        {
          "id": "pullRange",
          "label": "Pull Range",
          "values": [
            0,
            0,
            0,
            0,
            0,
            30,
            30,
            30,
            30,
            30,
            60,
            60,
            60,
            60,
            60,
            60,
            60,
            90,
            90,
            90
          ]
        }
      ],
      "levels": [
        {
          "level": 1,
          "features": [
            {
              "id": "storm-ward",
              "name": "Storm Ward",
              "description": "A crackling ward surrounds you. You add half your channelling modifier (rounded down) to your Armor Class.",
              "effects": [
                {
                  "do": {
                    "kind": "modify",
                    "target": "ac",
                    "op": "add",
                    "value": "floor(@alias.ce.mod / 2)"
                  }
                }
              ]
            }
          ]
        },
        {
          "level": 6,
          "features": [
            {
              "id": "thunder",
              "name": "Thunder Pull",
              "description": "Spend Mana to pull everything toward a point within range (the Pull Range column): creatures in a 10-foot radius per point make a Strength save or are pulled to the centre and take one Channel Die of force damage per point.",
              "effects": [
                {
                  "do": {
                    "kind": "grantAction",
                    "action": {
                      "id": "thunder-pull",
                      "name": "Thunder Pull",
                      "actionType": "technique",
                      "spend": {
                        "resourceId": "mana",
                        "min": "1",
                        "max": "@alias.ce.mod + 1"
                      },
                      "saveDc": "8 + @prof + @alias.ce.mod",
                      "saveAbility": "str",
                      "damage": "(@spent)d6",
                      "damageType": "force",
                      "range": "@table.pullRange",
                      "area": "10 * @spent"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "beast-blood",
      "name": "Beast Blood",
      "description": "You can call spirit animals to your side. You start with one and learn another at 4th level and every 4 levels after.",
      "tags": [
        "bloodline"
      ],
      "levelBasis": "highestClass",
      "levels": [
        {
          "level": 1,
          "features": [
            {
              "id": "beast-calling",
              "name": "Beast Calling",
              "description": "You can call spirit animals to your side. You start with one and learn another at 4th level and every 4 levels after.",
              "effects": [
                {
                  "do": {
                    "kind": "grantChoice",
                    "choice": {
                      "id": "spirit-beasts",
                      "label": "Spirit Beasts",
                      "count": "floor(@archetypeLevel / 4) + 1",
                      "from": {
                        "kind": "optionList",
                        "listId": "spirit-beasts"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
