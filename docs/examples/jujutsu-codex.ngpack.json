                  }
                }
              ]
            }
          ]
        },
        {
          "level": 6,
          "features": [
            {
              "id": "blue",
              "name": "Lapse: Blue",
              "description": "Spend Cursed Energy to pull everything toward a point within range (the Blue Range column): creatures in a 10-foot radius per point make a Strength save or are pulled to the centre and take one Technique Die of force damage per point.",
              "effects": [
                {
                  "do": {
                    "kind": "grantAction",
