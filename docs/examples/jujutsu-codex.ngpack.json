            10,
            10,
            10,
            10,
            10
          ]
        }
      ],
      "levels": [
        {
          "level": 1,
          "features": [
            {
              "id": "cursed-energy",
              "name": "Cursed Energy",
              "description": "Negative emotion condensed into usable power. You have a pool of Cursed Energy (the class table, plus your Cursed Energy modifier). It refills on a Long Rest; a Short Rest gives back half your Jujutsu Sorcerer level (rounded down, minimum 1). Cursed Strike: as an action, channel 2 Cursed Energy into a strike — proficiency + Cursed Energy modifier to hit, Technique Die twice + your modifier in Cursed damage. Cursed Energy Burst: as an action, release any amount of Cursed Energy up to your Cursed Energy modifier — a 30-foot line (+5 feet per point) dealing one Technique Die per point (Dexterity save halves). Focus (once per Short Rest, bonus action): steady your breathing to gain temporary Cursed Energy equal to your proficiency bonus.",
              "effects": [
                {
                  "do": {
                    "kind": "grantResource",
                    "resource": {
                      "id": "cursed-energy",
                      "name": "Cursed Energy",
                      "max": "@table.cursedEnergy + @alias.ce.mod",
                      "recharge": "long",
                      "shortRestRegain": "max(1, floor(@classLevel / 2))",
                      "display": "pool",
                      "description": "Fuels your techniques. Refills on a Long Rest; a Short Rest gives some back."
                    }
                  }
                },
                {
                  "do": {
                    "kind": "grantResource",
                    "resource": {
                      "id": "focus",
                      "name": "Focus",
                      "max": "1",
                      "recharge": "short",
                      "display": "uses",
                      "actionType": "bonus",
                      "description": "Gain temporary Cursed Energy equal to your proficiency bonus."
                    }
                  }
                },
                {
                  "do": {
                    "kind": "grantAction",
                    "action": {
                      "id": "cursed-strike",
                      "name": "Cursed Strike",
                      "actionType": "technique",
                      "cost": {
                        "resourceId": "cursed-energy",
                        "amount": "2"
                      },
                      "attackBonus": "@prof + @alias.ce.mod",
                      "damage": "2d@table.techniqueDie + @alias.ce.mod",
                      "damageType": "Cursed",
                      "description": "Spend 2 Cursed Energy: proficiency + Cursed Energy modifier to hit, Technique Die x2 + modifier Cursed damage."
                    }
                  }
                },
                {
                  "do": {
                    "kind": "grantAction",
                    "action": {
                      "id": "cursed-burst",
                      "name": "Cursed Energy Burst",
                      "actionType": "technique",
                      "spend": {
                        "resourceId": "cursed-energy",
                        "min": "1",
                        "max": "max(1, @alias.ce.mod)"
                      },
                      "saveDc": "8 + @prof + @alias.ce.mod",
                      "saveAbility": "dex",
                      "damage": "(@spent)d@table.techniqueDie",
                      "damageType": "Cursed",
                      "range": "30 + 5 * @spent",
                      "description": "Release any amount of Cursed Energy up to your modifier as a line: one Technique Die of Cursed damage per point, Dexterity save for half."
                    }
                  }
                },
                {
                  "do": {
                    "kind": "grantAction",
                    "action": {
                      "id": "focus-breath",
                      "name": "Focus",
                      "actionType": "bonus",
                      "cost": {
                        "resourceId": "focus",
                        "amount": "1"
                      },
                      "restores": [
                        {
                          "resourceId": "cursed-energy",
                          "amount": "@prof",
                          "temporary": true
                        }
                      ],
                      "description": "Gain temporary Cursed Energy equal to your proficiency bonus (spent first, gone on a rest)."
                    }
                  }
                },
                {
                  "do": {
                    "kind": "modify",
                    "target": "alias.ce.score",
                    "op": "add",
                    "value": "@counter.breakthroughs"
                  }
                }
              ]
            },
            {
              "id": "innate-technique",
              "name": "Innate Technique",
              "description": "You were born with a cursed technique — a unique way your Cursed Energy manifests. It grows with your highest class level: Limitless (requires a Cursed Energy ability of 16) or Ten Shadows.",
              "effects": [
                {
                  "do": {
                    "kind": "grantChoice",
                    "choice": {
                      "id": "technique",
                      "label": "Innate Technique",
                      "from": {
                        "kind": "archetypes",
                        "tags": [
                          "innate-technique"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "level": 2,
          "features": [
            {
              "id": "body-improvements",
              "name": "Body Improvements",
              "description": "Cursed Energy hardens your body. You have points equal to your Jujutsu Sorcerer level to spend on improvements (at most one Toughness improvement).",
              "effects": [
                {
                  "do": {
                    "kind": "grantChoice",
                    "choice": {
                      "id": "improvements",
                      "label": "Body Improvements",
                      "budget": "@classLevel",
                      "allowRepeats": true,
                      "groups": [
                        {
                          "id": "toughness",
                          "label": "Toughness",
                          "max": "1"
                        }
                      ],
                      "from": {
                        "kind": "optionList",
                        "listId": "body-improvements"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "level": 3,
          "features": [
            {
              "id": "domain-expansion",
              "name": "Domain Expansion",
              "description": "The pinnacle of jujutsu: you manifest your inner world around you. As an action, spend 5 Cursed Energy to expand your domain. While it lasts you gain +2 AC, advantage on attack rolls, and your Cursed Energy Output rises by your Jujutsu Sorcerer level. It ends when you choose to end it.",
              "effects": [
                {
                  "do": {
                    "kind": "grantToggle",
                    "toggle": {
                      "id": "domain-expansion",
                      "name": "Domain Expansion",
                      "actionType": "action",
                      "cost": {
                        "resourceId": "cursed-energy",
                        "amount": "5"
                      },
                      "effects": [
                        {
                          "do": {
                            "kind": "modify",
                            "target": "ac",
                            "op": "add",
                            "value": "2"
                          }
                        },
                        {
                          "do": {
                            "kind": "rollMode",
                            "target": "attack",
                            "mode": "advantage"
                          }
                        },
                        {
                          "do": {
                            "kind": "modify",
                            "target": "stat.output",
                            "op": "add",
                            "value": "@classLevel"
                          }
                        }
                      ],
                      "description": "Spend 5 Cursed Energy to expand your domain: +2 AC, advantage on attack rolls, and +your Jujutsu Sorcerer level to Cursed Energy Output until it ends."
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "level": 4,
          "features": [
            {
              "id": "asi-4",
              "name": "Ability Score Improvement",
              "description": "Increase your ability scores (one by 2, or two by 1) or take a feat you qualify for.",
              "effects": [
                {
                  "do": {
                    "kind": "grantChoice",
                    "choice": {
                      "id": "feat",
                      "label": "Ability Score Improvement or feat",
                      "from": {
                        "kind": "feats",
                        "categories": [
                          "General"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "level": 5,
          "features": [
            {
              "id": "black-flash",
              "name": "Black Flash",
              "description": "When Cursed Energy meets a blow within a millionth of a second, space distorts. Your attacks score a critical hit on a 19 or 20, and you have one extra reaction each round.",
              "effects": [
                {
                  "do": {
                    "kind": "modify",
                    "target": "crit.threshold",
                    "op": "add",
                    "value": "-1"
                  }
                },
                {
                  "do": {
                    "kind": "modify",
                    "target": "reactions",
                    "op": "add",
                    "value": "1"
                  }
                }
              ]
            }
          ]
        }
      ],
      "startingEquipment": []
    }
  ],
