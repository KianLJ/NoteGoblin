{
  "name": "notegoblin",
  "version": "0.3.7",
  "description": "A D&D campaign companion for DMs and players — notes, character sheets, initiative, and live party chat with friends over the internet.",
  "main": "./out/main/index.js",
  "author": "NoteGoblin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "relay:dev": "cd relay && npx wrangler dev",
    "relay:deploy": "cd relay && npx wrangler deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@types/dompurify": "^3.0.5",
    "@xhayper/discord-rpc": "^1.3.4",
    "argon2": "0.40.3",
    "better-sqlite3": "11.10.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "uuid": "9.0.1",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "9.0.8",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "electron-vite": "2.3.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "allowScripts": {
    "argon2@0.40.3": true,
    "better-sqlite3@11.10.0": true,
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
