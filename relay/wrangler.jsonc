{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notegoblin-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "Directory", "class_name": "Directory" },
      { "name": "Presence", "class_name": "Presence" },
      { "name": "Session", "class_name": "Session" }
    ]
  },
  // Each account's own music and sounds (src/audio.ts). Create it once with `npx wrangler r2 bucket create notegoblin-audio`.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "notegoblin-audio" }],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Directory", "Presence"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Session"]
    }
  ],
  // The web app (web/, built by `npm run web:build` from the repo root into
  // ./web-dist/app/) — served at /app/ from this same worker, so it calls the
  // directory API same-origin with no CORS. Any path that isn't a built file
  // falls through to the worker as before.
  "assets": {
    "directory": "./web-dist"
  },
  "routes": [
    { "pattern": "relay.notegoblin.uk", "custom_domain": true }
  ]
}
