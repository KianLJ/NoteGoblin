{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notegoblin-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "Directory", "class_name": "Directory" },
      { "name": "Presence", "class_name": "Presence" },
      { "name": "Session", "class_name": "Session" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Directory", "Presence"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Session"]
    }
  ],
  // The read-only web viewer (viewer/, built by `npm run viewer:build` from
  // the repo root into ./viewer-dist/viewer/) — served at /viewer/ from this
  // same worker, so it calls the directory API same-origin with no CORS.
  // Any path that isn't a built file falls through to the worker as before.
  "assets": {
    "directory": "./viewer-dist"
  },
  "routes": [
    { "pattern": "relay.notegoblin.uk", "custom_domain": true }
  ]
}
