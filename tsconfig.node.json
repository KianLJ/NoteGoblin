{
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/server/**/*",
    "shared/**/*",
    "src/renderer/src/color.ts",
    "relay/src/lib/loginLimit.ts",
    "src/renderer/src/wikilink.ts",
    "src/renderer/src/markdownTable.ts",
    "src/renderer/src/features/campaigns/noteEditorMenu.ts",
    "src/renderer/src/data/npcNames.ts",
    "src/renderer/src/features/browser/browserTabs.ts",
    "db/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@server/*": ["src/server/*"]
    }
  }
}
